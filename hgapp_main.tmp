/**
 * hgapp_adblock.js — 黄果短剧 Flutter APP（/api/v1 网关）全量去广告清洗器 v2
 *
 * 加密方案（逆向自 main.dart.js）：
 *   响应体 = JSON 包装 {data, errcode, sign, timestamp}，data = base64(AES-128-CBC(JSON))
 *   Key = "MZWoFXxL7t5S0XdY"  IV = "ZhsuMTpBuUdpcGkL"，PKCS7
 *   客户端主流程不校验 sign 字段（仅 404 分支使用），改写 data 后无需重算签名。
 *
 * v2：改为全量递归清洗 —— 覆盖所有 /api/v1/* 接口，不再枚举端点。
 *   HAR 实测埋广告的接口：app/config、content/videos/detail、episode-detail、
 *   episodes-list、short-drama/theater/config、discovery-config、feed-ads、theater/notice
 *
 * 清洗规则（递归遍历整个 data）：
 *   1. 任意数组中出现带 advertise_location_code / ad_slot_name 的对象 → 整个数组清空
 *   2. data.ads（对象）：每个子槽位的 items 数组清空；short_drama_policy 倒计时/前插/暂停全部关闭
 *   3. 顶层广告数组字段（ads_media/ads_pop/ads_screen/floating_ads/
 *      short_drama_pause_ads/short_drama_pre_roll_ads/apps）→ 清空
 *   4. 带 placement_code + items 的广告位载荷（如 feed-ads）→ enabled=false、items 清空、倒计时归零
 *   5. theater/notice（text+target_page 结构）→ enabled=false、text 清空
 *
 * 非广告数据一律原样保留（剧集列表、用户信息、VIP 配置等不触碰）。
 */

(function () {
  if (typeof $response === "undefined" || !$response || !$response.body) {
    $done({});
    return;
  }

  var url = (typeof $request !== "undefined" && $request && $request.url) ? String($request.url) : "";

  try {
    var outer = JSON.parse($response.body);
    if (!outer || typeof outer.data !== "string" || outer.data.length === 0) {
      $done({});
      return;
    }

    var plain = decryptAES(outer.data);
    if (!plain) {
      console.log("[hgapp] 解密失败 url=" + url);
      $done({});
      return;
    }

    var obj;
    try { obj = JSON.parse(plain); } catch (e) { $done({}); return; }
    var d = obj.data;
    if (!d || typeof d !== "object") {
      // bootstrap 等接口 data 是再加密的字符串，无法安全清洗，原样放行
      $done({});
      return;
    }

    var changed = false;
    var AD_ARRAY_KEYS = ["ads_media", "ads_pop", "ads_screen", "floating_ads",
      "short_drama_pause_ads", "short_drama_pre_roll_ads", "apps"];

    function isAdItem(o) {
      return o && typeof o === "object" &&
        (o.advertise_location_code !== undefined || o.ad_slot_name !== undefined);
    }

    function emptyArr(a) {
      if (Array.isArray(a) && a.length > 0) { a.length = 0; changed = true; }
    }

    function walk(o) {
      if (Array.isArray(o)) {
        var hasAd = false;
        for (var i = 0; i < o.length; i++) { if (isAdItem(o[i])) { hasAd = true; break; } }
        if (hasAd) { emptyArr(o); return; }
        for (var j = 0; j < o.length; j++) walk(o[j]);
        return;
      }
      if (!o || typeof o !== "object") return;

      for (var k in o) {
        if (!Object.prototype.hasOwnProperty.call(o, k)) continue;
        var v = o[k];

        // 广告位集合对象 data.ads.{slot}.items / data.ads.feed.items
        if (k === "ads" && v && typeof v === "object" && !Array.isArray(v)) {
          for (var k2 in v) {
            if (!Object.prototype.hasOwnProperty.call(v, k2)) continue;
            var slot = v[k2];
            if (slot && typeof slot === "object" && !Array.isArray(slot)) {
              if (Array.isArray(slot.items)) { emptyArr(slot.items); }
              if (slot.enabled !== undefined) { slot.enabled = false; changed = true; }
            } else if (Array.isArray(slot)) {
              emptyArr(slot);
            }
          }
          // 前插/暂停广告策略
          if (v.short_drama_policy && typeof v.short_drama_policy === "object") {
            var pol = v.short_drama_policy;
            if (pol.countdown_seconds !== undefined && pol.countdown_seconds !== 0) { pol.countdown_seconds = 0; changed = true; }
            if (pol.pause !== undefined && pol.pause !== false) { pol.pause = false; changed = true; }
            if (pol.pre_roll !== undefined && pol.pre_roll !== false) { pol.pre_roll = false; changed = true; }
          }
          continue;
        }

        // 已知顶层广告数组字段
        if (AD_ARRAY_KEYS.indexOf(k) !== -1) {
          if (Array.isArray(v)) { emptyArr(v); }
          else if (v && typeof v === "object" && Array.isArray(v.items)) { emptyArr(v.items); if (v.enabled !== undefined) { v.enabled = false; changed = true; } }
          else if (v && typeof v === "object") { o[k] = null; changed = true; }
          continue;
        }

        // 通用广告位载荷（feed-ads 等）：placement_code + items
        if (v && typeof v === "object" && !Array.isArray(v) && v.placement_code && Array.isArray(v.items)) {
          if (v.enabled !== false) { v.enabled = false; changed = true; }
          if (v.countdown_seconds !== undefined && v.countdown_seconds !== 0) { v.countdown_seconds = 0; changed = true; }
          if (v.interval !== undefined && v.interval !== 0) { v.interval = 0; changed = true; }
          if (v.can_skip === false) { v.can_skip = true; changed = true; }
          emptyArr(v.items);
          continue;
        }

        // 导流公告（theater/notice）
        if (v && typeof v === "object" && !Array.isArray(v) &&
            v.text !== undefined && v.target_page !== undefined) {
          if (v.enabled !== false) { v.enabled = false; changed = true; }
          if (v.text !== "") { v.text = ""; changed = true; }
          continue;
        }

        walk(v);
      }
    }

    walk(d);

    if (!changed) {
      $done({});
      return;
    }

    outer.data = encryptAES(JSON.stringify(obj));
    console.log("[hgapp] 已清洗 url=" + url);
    $done({ body: JSON.stringify(outer) });
  } catch (e) {
    console.log("[hgapp] 异常 " + e + " url=" + url);
    $done({});
  }
})();
