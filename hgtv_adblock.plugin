#!name = 黄果短剧去广告纯净版
#!desc = 屏蔽开屏广告、首页应用宫格弹窗、海报弹窗、横幅广告、系统公告弹窗，并秒过5秒开屏倒计时
#!author = zhendemyq
#!tag = 去广告

[Rule]
URL-REGEX, ^https?:\/\/[^\/]+\/api\/track\/first-launch, REJECT-200
URL-REGEX, ^https?:\/\/[^\/]+\/api\/ad\/event, REJECT-200

[Script]
http-response ^https?:\/\/[^\/]+\/api\/dispatch script-path=https://raw.githubusercontent.com/zhendemyq/Claude_Loon_All.list/main/hgtv_adblock.js, requires-body=true, max-size=3145728, timeout=10, tag=黄果短剧_去广告与公告
http-response ^https?:\/\/[^\/]+\/assets\/router-[A-Za-z0-9_-]+\.js script-path=https://raw.githubusercontent.com/zhendemyq/Claude_Loon_All.list/main/hgtv_skip_splash.js, requires-body=true, max-size=3145728, timeout=10, tag=黄果短剧_秒过开屏

[MITM]
hostname = *.hgtdwlyo.cc, *.xfyty.top, *.huigu.top, *.dlbmhx.top, *.lzmxmq.top, *.hgtv-vmmlyt.vip, *.fi8rnajon.top, *.huangguoai.com, *.huangguoai.cc, *.huangguoai.app, *.hgdjai.app
