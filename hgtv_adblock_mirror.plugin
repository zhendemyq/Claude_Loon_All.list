#!name = 黄果短剧去广告纯净版 v18(镜像版)
#!desc = 与正式版内容完全一致；镜像版仅为兼容旧订阅地址保留
#!author = zhendemyq
#!loon_version = 3.5.1(978)
#!date = 2026-11-07
#!type = normal
#!tag = 去广告

# ======================================================================
# v18：解决"播放很卡" —— 换用站点自带的 HEVC 源
#   实测同一集的两条流（真实下载测速，非估算）：
#     streams.main (H.264) : 1280x720  ，平均 8.87 Mbps  ← 站点默认给这条
#     streams.hevc (H.265) : 1920x1080 ，平均 2.18 Mbps  ← 站点备着但不默认用
#   H.264 这条码率是 H.265 的 4 倍、分辨率还低一档，手机带宽稍差就必然卡。
#   hevc 的 m3u8 是标准 fMP4（VERSION:6 / EXT-X-MAP / ENDLIST），init 段里是
#   hvc1 而非 hev1 —— 正是 Safari 唯一支持的写法，iOS 原生即可播。
#   做法：在播放接口响应里把 main 与 hevc 两条 URL 对调，
#     前端读到 main 就是 HEVC 源，原来的 H.264 留在 hevc 字段当失败回退。
#   仅在 hevc 非空时生效（约 83% 的剧有 HEVC 源），hevc 为空的剧保持原样。
#   仅对 iPhone/iPad/Mac 生效，Android 等不支持 HEVC 的设备不受影响。
#
# 另加两条提速规则：
#   · 视频/图片 CDN（drleao.cn、hzjvlo.cn）是国内腾讯云，实测直连 60-90 Mbps，
#     让它 DIRECT，避免被代理节点绕到海外再回来 —— 这是"卡"的另一半原因。
#   · 站点挂了 Google Analytics（gtag），国内不可达会一直挂起等超时，直接 REJECT。
# ======================================================================

# ======================================================================
# v14：全部拦截改走 [Rewrite] 立即响应
#   用户反馈 v13 后"点击/播放特别慢"：Loon [Rule] REJECT 是直接断连，
#   Safari 会重试干等到超时。改用 reject-dict 立刻回 {}（合法 JSON/JS），
#   前端立刻拿到响应：广告判断失败静默跳过，页面不再卡。
#   v14~v16 曾用左下角徽标显示版本号便于远程排查，v17 已全部移除。
#
# v13 新增：掐断首页大图轮播广告的供数接口 /api/site/home-slots
#   （home-hero.js 把该接口返回的 isAd 项合并进轮播；接口失败会被静默 catch，
#     轮播只播 SSR 里的真实剧集，无副作用。同时掐 /api/sdk/ad/* 兜底供数口。）
#
# v12 修的是 v11 仍然"没反应"的真正原因：域名根本对不上
#
# 站点官方地址发布页（hgai12.com）明确写着：
#   永久主域名 huangguoai.com ｜ 永久中转 huangguoai.ai
#   线路 01 推荐首选  hfvoe.gitiecgad.cc
#   线路 02 稳定      yh3cnl.gitiecgad.cc
#   线路 03 应急      ft35a.gitiecgad.cc
#   hgai12.com（地址发布页）／huangguoai.pages.dev（永久发布页）
# 实测 huangguoai.io、hfvoe.gitiecgad.cc、yh3cnl.gitiecgad.cc 都是完整主站副本，
# 广告位结构与 huangguoai.com 完全一致（同一套 SSR 模板）。
# v4~v11 只写了 huangguoai.com/.cc/.app，用户在推荐线路上打开 → 一条规则都不匹配。
# 本版把域名收进一个后缀正则，同时修掉 v11 的 MITM 裸域遗漏。
#
# 页面结构（实测首页 154KB / 视频页 201KB 源码）：
#   <aside class="hg-ssp-slot" data-ssp-slot-key="banner_home_top_card_001" ...
#          style="min-height:179px;width:100%;..."></aside>
#   首页 3 个、视频页 6 个，全是空壳，min-height 写死在行内样式里。
#   → 直接把整个 <aside ...></aside> 从源码删掉，连节点都不留。
#
# 另两类与 SSP 无关的广告也在这里关掉：
#   · 播放器跳转/外链广告：SSR 内联 JSON videoInitialData.playAd
#   · 连播前贴片视频广告（sq_ad position=15）：videoInitialData.prerollAd
#   做法是改写字段名，前端 data.playAd / data.prerollAd 变 undefined，广告层不再挂载；
#   同时把素材接口 /api/media/prerolls/*/playback 直接回空 JSON。
# ======================================================================

[Rule]
# ---------- 视频/图片 CDN 直连（国内腾讯云，实测 60-90 Mbps）----------
# 若走代理节点，6-9 Mbps 的视频流绕到海外再回来，这是播放卡顿的主因之一。
DOMAIN-SUFFIX,drleao.cn,DIRECT
DOMAIN-SUFFIX,hzjvlo.cn,DIRECT
# ---------- 国内不可达的统计脚本：直接断连，别让它挂起等超时 ----------
DOMAIN,www.googletagmanager.com,REJECT
DOMAIN,www.google-analytics.com,REJECT
# ---------- 第三方广告网络 & 上报节点（跨域请求，断连不影响页面速度） ----------
DOMAIN-KEYWORD,adsdk,REJECT
DOMAIN-SUFFIX,adsdk3.cc,REJECT
DOMAIN-SUFFIX,adsdk4.cc,REJECT
DOMAIN-SUFFIX,adsdk5.cc,REJECT
DOMAIN,api-dc-prod-008.cyou,REJECT
DOMAIN,api-dc2-prod-08.cyou,REJECT

[Rewrite]
# ===== 1. 删除广告位 DOM 节点（主域 + 中转域 + 全部线路域名）=====
^https?://(?:[a-z0-9-]+\.)*(?:huangguoai\.(?:com|cc|app|ai|io)|huangguoai\.pages\.dev|gitiecgad\.cc|gtlgrwyb\.cc|hgai12\.com)/($|\?|video|ranks|ai-duanju|search|topics|tag|author|chigua|navigate|go-home|archives|post|detail) response-body-replace-regex <aside[^>]*data-ssp-slot-key[^>]*></aside> <!--hg-ad-removed-->

# ===== 2. 关掉播放器广告（改字段名，前端读到 undefined 就不挂载）=====
^https?://(?:[a-z0-9-]+\.)*(?:huangguoai\.(?:com|cc|app|ai|io)|huangguoai\.pages\.dev|gitiecgad\.cc|gtlgrwyb\.cc|hgai12\.com)/($|\?|video|ranks|ai-duanju|search|topics|tag|author|chigua|navigate|go-home|archives|post|detail) response-body-replace-regex prerollAd hgxPrerollAd playAd hgxPlayAd

# ===== 3. 注入 CSS 兜底（防 SDK 动态插入的悬浮/暂停/宫格广告）=====
^https?://(?:[a-z0-9-]+\.)*(?:huangguoai\.(?:com|cc|app|ai|io)|huangguoai\.pages\.dev|gitiecgad\.cc|gtlgrwyb\.cc|hgai12\.com)/($|\?|video|ranks|ai-duanju|search|topics|tag|author|chigua|navigate|go-home|archives|post|detail) response-body-replace-regex </head> <style>.hg-ssp-slot,[data-ssp-slot-key],[data-ssp-floating-container],.hg-ssp-floating,.hg-ssp-pause__card,[data-ssp-pause]{display:none!important;height:0!important;min-height:0!important;margin:0!important;padding:0!important;overflow:hidden!important}</style></head>

# ===== 4. 广告位配置接口：密文换成空对象密文（解出来是 {}）=====
^https?://(?:[a-z0-9-]+\.)*(?:huangguoai\.(?:com|cc|app|ai|io)|huangguoai\.pages\.dev|gitiecgad\.cc|gtlgrwyb\.cc|hgai12\.com)/api/ad/query response-body-json-replace data "jIY1j26vNjsdMuRZijJHvQ=="

# ===== 5. 贴片广告素材接口：直接回空 JSON =====
^https?://(?:[a-z0-9-]+\.)*(?:huangguoai\.(?:com|cc|app|ai|io)|huangguoai\.pages\.dev|gitiecgad\.cc|gtlgrwyb\.cc|hgai12\.com)/api/media/prerolls/ reject-dict

# ===== 6. (v14) 首页轮播广告供数接口：立刻回空 JSON =====
# home-hero.js POST 此接口，把 data.items 里 isAd=true 的项合并进首页大图轮播。
# 回 {} 后 status!==1，前端直接忽略，轮播只播 SSR 里的真实剧集。
# v13 用 [Rule] REJECT 断连，前端干等超时 → 又慢又可能没拦住；Rewrite 是立即响应。
^https?://(?:[a-z0-9-]+\.)*(?:huangguoai\.(?:com|cc|app|ai|io)|huangguoai\.pages\.dev|gitiecgad\.cc|gtlgrwyb\.cc|hgai12\.com)/api/site/home-slots reject-dict

# ===== 7. (v14) SSP SDK 兜底供数口：立刻回空 JSON =====
^https?://(?:[a-z0-9-]+\.)*(?:huangguoai\.(?:com|cc|app|ai|io)|huangguoai\.pages\.dev|gitiecgad\.cc|gtlgrwyb\.cc|hgai12\.com)/api/sdk/ad/ reject-dict

# ===== 8. (v14) SSP 广告 SDK 脚本本体：回 200 空 JSON（合法 JS，不报错不重试） =====
# 站点源码注释自述：故意把 SDK 改名成 ssp-core（"带 ad 字样的路径会被拦截插件整条拦掉"）
^https?://(?:[a-z0-9-]+\.)*(?:huangguoai\.(?:com|cc|app|ai|io)|huangguoai\.pages\.dev|gitiecgad\.cc|gtlgrwyb\.cc|hgai12\.com)/static/web/js/(lib/(web-sdk|ssp-core)-[A-Za-z0-9._-]+\.js|ssp-mount\.js|ssp-cache-scope\.js) reject-dict

# ===== 9. (v15 核心修复) 破解 API 聚合网关 =====
# 页面把 window.fetch 整个劫持（edge-cache-runtime.js），所有 /api/* 请求都改道到
# POST /api/edge/request，真实路径只存在于请求体里 —— 所以 v13/v14 按路径写的
# 接口规则在线路上根本看不到目标请求，全部被架空。
# 该脚本里 /^\/api\/(?:edge|remote)(?:\/|$)/ 是"不改道名单"，且 edge|remote 全文唯一。
# 这里把它扩成：广告相关接口（轮播供数/SDK供数/ad-query/贴片素材）不再改道，
# 直接走明线 fetch —— 上面第 4/5/6/7 条规则就能真正拦到它们。
# 替换值用 [\x2f] 代替 \/，避免反斜杠在 Loon 替换串里的转义歧义。
^https?://(?:[a-z0-9-]+\.)*(?:huangguoai\.(?:com|cc|app|ai|io)|huangguoai\.pages\.dev|gitiecgad\.cc|gtlgrwyb\.cc|hgai12\.com)/static/web/js/edge-cache-runtime\.js response-body-replace-regex edge\|remote edge|remote|site[\x2f]home-slots|sdk[\x2f]ad|ad[\x2f]query|media[\x2f]prerolls

# ===== 10. (v16 核心 A) 网关层直接摘除广告数据 =====
# 实测网关把内部响应原文直接返回（无信封）。轮播组件是全站唯一使用 isAd 字段的代码，
# 它只挑 isAd=true 的项进轮播。把网关响应里的 isAd:true 全部改成 false：
# 轮播拿到 0 个广告项，其他功能零影响。此规则不依赖任何脚本补丁送达。
^https?://(?:[a-z0-9-]+\.)*(?:huangguoai\.(?:com|cc|app|ai|io)|huangguoai\.pages\.dev|gitiecgad\.cc|gtlgrwyb\.cc|hgai12\.com)/api/edge/request response-body-replace-regex \"isAd\":true \"isAd\":false

# ===== 11. (v16 核心 B) 破脚本强缓存 =====
# 静态脚本 Cache-Control: max-age=3600 且内容不变 → 过期后 Safari 发 304 校验，
# 304 不传输响应体，改写永远没机会应用 —— 这是 v15 补丁"已推送但没生效"的原因。
# 改写 HTML 里的版本号参数强制浏览器重新下载全部脚本（新版 URL 首次就经过 Loon 改写）。
^https?://(?:[a-z0-9-]+\.)*(?:huangguoai\.(?:com|cc|app|ai|io)|huangguoai\.pages\.dev|gitiecgad\.cc|gtlgrwyb\.cc|hgai12\.com)/($|\?|video|ranks|ai-duanju|search|topics|tag|author|chigua|navigate|go-home|archives|post|detail) response-body-replace-regex \?v=20261106002 ?v=20261106002k16

# ===== 12. (v16) web-sdk 无版本参数，单独加戳 =====
^https?://(?:[a-z0-9-]+\.)*(?:huangguoai\.(?:com|cc|app|ai|io)|huangguoai\.pages\.dev|gitiecgad\.cc|gtlgrwyb\.cc|hgai12\.com)/($|\?|video|ranks|ai-duanju|search|topics|tag|author|chigua|navigate|go-home|archives|post|detail) response-body-replace-regex web-sdk-v1\.2\.0-20261029\.js web-sdk-v1.2.0-20261029.js?k16

# ===== 13. (v18 核心) 播放源对调：main ← hevc，解决播放卡顿 =====
# 站点在同一个接口里同时给两条流，前端只用 streams.main（H.264 720p / 8.87 Mbps），
# streams.hevc（H.265 1080p / 2.18 Mbps）只被记下来当回退。这里把两条 URL 对调：
#   "main":"<H264>","hevc":"<HEVC>"  →  "main":"<HEVC>","hevc":"<H264>"
# 前端因此直接播 HEVC（更清晰且码率只有 1/4），原 H.264 留在 hevc 字段做失败回退。
# · 仅当 hevc 非空时正则才命中（要求 "hevc":"https...），无 HEVC 的剧保持原样；
# · 用 \x2c 写逗号，避免被当成参数分隔符；
# · 仅对 iPhone/iPad/Mac 生效，不支持 HEVC 的设备完全不受影响。
response if ${url} ~= /^https:\/\/(?:[a-z0-9-]+\.)*(?:huangguoai\.(?:com|cc|app|ai|io)|huangguoai\.pages\.dev|gitiecgad\.cc|gtlgrwyb\.cc|hgai12\.com)\/api\/(?:edge\/request|videos\/|media\/playback\/)/ && ${request.header['User-Agent']} ~= /iPhone|iPad|Macintosh/ then response.body.replace(/"main":"([^"]*)"\x2c"hevc":"(https[^"]+)"/, "\"main\":\"$2\",\"hevc\":\"$1\"")

[MITM]
# ⚠️ 裸域必须单独写：Loon 的 *.x 通配不包含 x 本身（官方示例里 example.com 与 *.example.org 就是分开的）
# ⚠️ hostname 只能有一行，合并时把你原有的与下面合并成一行、去重，不要整行替换
hostname = huangguoai.com, *.huangguoai.com, huangguoai.cc, *.huangguoai.cc, huangguoai.app, *.huangguoai.app, huangguoai.ai, *.huangguoai.ai, huangguoai.io, *.huangguoai.io, huangguoai.pages.dev, hgai12.com, *.hgai12.com, *.gitiecgad.cc, *.gtlgrwyb.cc, *.hgtdwlyo.cc, *.xfyty.top, *.huigu.top, *.dlbmhx.top, *.lzmxmq.top, *.hgtv-vmmlyt.vip, *.fi8rnajon.top, *.hgapi-ykbxse.cc, *.laotaiqiu.top, *.hgdjai.app, *.mhmtwvtu.cn, *.rmiytgvl.cn, *.sqyzcys20z.cc, *.bpvykh-mgapi.shop
